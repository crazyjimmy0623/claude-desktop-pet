{
  "name": "deskmates",
  "productName": "Deskmates",
  "version": "0.1.0",
  "private": true,
  "description": "Tiny pixel deskmates that work beside you and act out what your Claude Code sessions are doing.",
  "license": "MIT",
  "author": "crazyjimmy0623",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test-mode": "electron . --test-mode",
    "preview": "electron scripts/preview/capture.js",
    "install-hooks": "node scripts/install-hooks.js",
    "uninstall-hooks": "node scripts/install-hooks.js --uninstall",
    "icon": "node scripts/make-icon.js",
    "predist": "npm run icon",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.crazyjimmy0623.deskmates",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/foreground.ps1"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Deskmates-Setup-${version}.${ext}",
      "shortcutName": "Deskmates"
    }
  }
}
